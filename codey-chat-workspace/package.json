{
  "name": "codey-chat-workspace",
  "version": "1.0.13",
  "description": "Codey AI 聊天工作区组件 — 可嵌入业务页面的智能对话面板，支持流式会话、历史管理、工作区上下文联动。",
  "type": "module",
  "main": "./dist/codey-chat-workspace.cjs.js",
  "module": "./dist/codey-chat-workspace.esm.js",
  "exports": {
    ".": {
      "import": "./dist/codey-chat-workspace.esm.js",
      "require": "./dist/codey-chat-workspace.cjs.js"
    },
    "./dist/style.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "npm run build",
    "publish:dry": "node scripts/publish.js --dry-run",
    "publish:run": "node scripts/publish.js"
  },
  "keywords": [
    "vue",
    "chat",
    "ai",
    "assistant",
    "workspace"
  ],
  "license": "SEE LICENSE IN ../LICENSE",
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "vite": "^5.0.0"
  }
}
